# Backend
PORT=5000

# Grafana (used in docker-compose)
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Frontend (set at build time for production)
VITE_API_URL=https://clothing-store-backend.onrender.com

# GitHub Actions Secrets (set in repo Settings → Secrets)
# RENDER_BACKEND_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxx?key=yyy
# RENDER_FRONTEND_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxx?key=yyy
# DOCKERHUB_USERNAME=your-dockerhub-username
# DOCKERHUB_TOKEN=your-dockerhub-access-token
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
